# Required
MASTER_KEY=            # base64 of 32 random bytes: openssl rand -base64 32  (encrypts upstream secrets; losing it loses them)
ADMIN_TOKEN=           # >= 16 chars; Bearer token for /admin/*

# Optional (defaults shown)
# HOST=127.0.0.1
# PORT=8080
# DB_PATH=./data/router.db
# PRICING_SYNC_ENABLED=true
# PRICING_SYNC_INTERVAL_HOURS=24
# MODEL_SYNC_INTERVAL_HOURS=6    # re-fetch each provider's model list; 0 = only on demand
# UNPRICED_MODELS=allow          # allow = bill $0 and flag price_source=unknown; reject = 422
# UPSTREAM_TIMEOUT_MS=120000     # time to first response headers from upstream
# WEB_DIST=../web/dist           # serve the built admin UI (the Docker image sets /app/web)
